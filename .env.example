DATABASE_URL="postgresql://app-role:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=verify-full"
DATABASE_DIRECT_URL="postgresql://owner-role:password@ep-example.region.aws.neon.tech/neondb?sslmode=verify-full"
AUTH_DATABASE_URL="postgresql://auth-webhook-role:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=verify-full"
SCHEDULER_DATABASE_URL="postgresql://scheduler-role:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=verify-full"
# Optional: use a dedicated operator role instead of DATABASE_DIRECT_URL for invite commands.
INVITATION_OPERATOR_DATABASE_URL="postgresql://invite-operator-role:password@ep-example.region.aws.neon.tech/neondb?sslmode=verify-full"
NEON_AUTH_BASE_URL="https://ep-example.neonauth.region.aws.neon.tech/neondb/auth"
NEON_AUTH_COOKIE_SECRET="generate-with-openssl-rand-base64-32"
CRON_SECRET="generate-with-openssl-rand-base64-32"
PRIVACY_CONTROLLER_NAME="Legal name of the data controller"
PRIVACY_CONTROLLER_ADDRESS="Controller address in Mexico"
PRIVACY_CONTACT_EMAIL="privacy@example.com"
SECURITY_CONTACT_EMAIL="security@example.com"
# Disabled by default for the closed beta.
NEXT_PUBLIC_ENABLE_ANALYTICS="false"
